{
    "name": "paulhibbert/features",
    "description": "Lightweight simple feature flags for Laravel",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Paulhibbert\\Features\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "authors": [
        {
            "name": "Paul Hibbert",
            "email": "30866933+paulhibbert@users.noreply.github.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.0",
        "illuminate/support": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/config": "^13.0",
        "illuminate/view": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Paulhibbert\\Features\\FeaturesServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "11.2",
        "phpstan/phpstan": "2.2",
        "laravel/pint": "^1.32.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "scripts": {
        "pre-commit": [
            "vendor/bin/pint",
            "vendor/bin/phpstan analyse",
            "vendor/bin/phpunit"
        ]
    }
}
